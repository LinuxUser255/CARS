# =============================================================================
# .zshrc  --  optimized for fast startup & low per-command overhead
# =============================================================================
# Changes from original:
#   - alias-finder plugin removed   (hooks every command, ~80 aliases = lag)
#   - ENABLE_CORRECTION removed     (spell-check on every command entry)
#   - rehash true removed           (rescanned PATH on every tab-completion)
#   - pyenv lazy-loaded             (only initialises on first real use)
#   - pyenv shims added statically  (fixes python/pip resolving to system bin)
#   - typeset -U path               (deduplicates PATH, no subprocess)
#   - duplicate $HOME/.local/bin    (removed second copy)
#   - ${+commands[cmd]}             (replaces command -v forks)
#   - zcompile guard                (kept + extended to compdump)
#   - completion caching enabled    (use-cache + cache-path, avoids repeat forks)
#   - grok fpath moved before compinit, duplicate compinit call removed
#   - duplicate zsource alias removed
#   - new zero-cost-until-used plugins added (sudo, extract, colored-man-pages,
#     zsh-completions, zsh-history-substring-search)
# =============================================================================

# =============================================================================
# OH-MY-ZSH CORE
# =============================================================================

# Use ${ZSH:-...} so a pre-existing $ZSH env-var is respected, and we never
# end up with an empty path if the export is somehow skipped.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"

ZSH_THEME="robbyrussell"

# Skip the insecure-directory check -- saves a find(1) fork on every launch
ZSH_DISABLE_COMPFIX="true"

# Never auto-update at startup
zstyle ':omz:update' mode disabled
zstyle ':omz:update' frequency 10

# Async git prompt (OMZ alpha -- keeps prompt non-blocking on large repos)
zstyle ':omz:alpha:lib:git' async-prompt yes

# Completion waiting dots -- cosmetic only, negligible cost
COMPLETION_WAITING_DOTS="true"

# Fold grok's completions dir in BEFORE compinit runs (inside oh-my-zsh.sh
# below) so they're picked up on the first pass instead of requiring a
# second compinit call later.
fpath=(~/.grok/completions/zsh $fpath)

# Plugins
# Removed: alias-finder       -- hooks every command to scan all aliases
# Removed: ENABLE_CORRECTION  -- was forking a spell-check before every command
# Added (all zero-cost until actually invoked):
#   sudo                      -- ESC ESC prepends sudo to current/last command
#   extract                   -- extract <file> handles tar/zip/gz/7z/rar/etc.
#   colored-man-pages         -- colorizes man output
#   zsh-completions           -- extra completion defs (cargo, go, rustup, etc.)
#   zsh-history-substring-search -- Up/Down filters history by substring
plugins=(
  git
  sudo
  extract
  colored-man-pages
  zsh-completions
  zsh-syntax-highlighting
  zsh-history-substring-search
  zsh-autosuggestions
)

# Guard: only source if the file is actually there
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  echo "[.zshrc] WARNING: oh-my-zsh not found at $ZSH" >&2
fi

# zsh-history-substring-search key bindings (harmless if already bound by
# the plugin -- kept explicit so Up/Down behavior doesn't silently regress)
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# =============================================================================
# LANGUAGE / EDITOR
# =============================================================================

export LANG=en_US.UTF-8

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

export ZSH_2000_DISABLE_RVM='true'
export GIT_TERMINAL_PROMPT=0

# Never let pip install outside a venv
export PIP_REQUIRE_VIRTUALENV=true

# =============================================================================
# PATH  --  one place, deduplicated, no subshells
# =============================================================================
#
# typeset -U tells zsh to silently drop duplicate entries from the path array.
# path (lowercase) is the zsh array form of PATH -- they stay in sync.

export GOPATH="$HOME/Projects/go"
export PYENV_ROOT="$HOME/.pyenv"

typeset -U path
path=(
  "$HOME/bin"
  "$HOME/.local/bin"        # pip user installs, ruff-lsp, etc.
  "$PYENV_ROOT/shims"       # pyenv version-selected python/pip -- MUST be
                             # static; the lazy pyenv() wrapper below only
                             # fires on a literal `pyenv` call, so python/pip
                             # invoked directly would otherwise skip pyenv
                             # entirely and hit system Python.
  "$HOME/.pyenv/bin"        # pyenv shims (cheap -- actual init is lazy below)
  "/usr/local/go/bin"       # Go toolchain
  "$GOPATH/bin"             # Go user binaries
  "$HOME/.juliaup/bin"      # juliaup-managed Julia
  "$HOME/.grok/bin"         # grok CLI
  "./node_modules/.bin"     # project-local node tools
  $path                     # keep whatever /etc/zprofile already set
)
export PATH

# =============================================================================
# LAZY LOADERS
# =============================================================================

# -- pyenv -------------------------------------------------------------------
# BEFORE: eval "$(pyenv init -)"   <-- subshell fork + eval on every launch
# AFTER:  stub function; real init runs only on first actual pyenv call.
# NOTE: shims are already static in PATH above, so version resolution for
# python/pip works immediately -- this wrapper just defers the env-var /
# completion setup that `pyenv init -` also does.

pyenv() {
  unfunction pyenv                   # remove this stub
  eval "$(command pyenv init -)"     # real init, one time only
  pyenv "$@"                         # forward the original call
}


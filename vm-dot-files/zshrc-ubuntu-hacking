# Esc Esc: toggle "sudo " on the current line (empty line = last command)
sudo-command-line() {
    [[ -z $BUFFER ]] && zle up-history
    local c=$CURSOR
    if [[ $BUFFER == sudo\ * ]]; then
        BUFFER="${BUFFER#sudo }"; CURSOR=$(( c > 5 ? c - 5 : 0 ))
    else
        BUFFER="sudo $BUFFER"; CURSOR=$(( c + 5 ))
    fi
}

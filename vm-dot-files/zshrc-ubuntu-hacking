# take: smarter mkcd
# take new-dir                                  -> mkdir + cd
# take https://github.com/user/repo.git         -> git clone + cd
# take https://example.com/tool.tar.gz          -> download + extract + cd
take() {
    if [[ -z "${1:-}" ]]; then
        printf 'Usage: take <dir | git-url | tarball-url>\n' >&2
        return 1
    fi
    case "$1" in
        http*://*.tar.gz|http*://*.tgz|http*://*.tar.xz|http*://*.tar.bz2|http*://*.tar)
            _take_tarball "$1" ;;
        git@*|ssh://*|*.git|https://github.com/*|https://gitlab.com/*)
            _take_git "$1" ;;
        *)
            mkcd "$1" ;;
    esac
}
_take_git() {
    local dir=${${${1%/}:t}##*:}
    dir=${dir%.git}
    git clone "$1" "$dir" && cd "$dir"
}
_take_tarball() {
    local tmp dir
    tmp=$(mktemp) || return 1
    if curl -fsSL "$1" -o "$tmp"; then
        dir=$(tar -tf "$tmp" | head -n1 | cut -d/ -f1)
        tar -xf "$tmp" && [[ -n $dir ]] && cd "$dir"
    fi
    rm -f "$tmp"
}

# --- extract any archive ---------------------------------------------
# extract file.tar.gz     (or: x file.zip other.7z)
extract() {
    if (( $# == 0 )); then
        printf 'Usage: extract <archive>...\n' >&2
        return 1
    fi
    local f
    for f in "$@"; do
        [[ -f $f ]] || { printf "extract: '%s' is not a file\n" "$f" >&2; continue; }
        case ${f:l} in
            *.tar.gz|*.tgz)          tar xzf "$f" ;;
            *.tar.bz2|*.tbz2)        tar xjf "$f" ;;
            *.tar.xz|*.txz)          tar xJf "$f" ;;
            *.tar.zst)               tar --zstd -xf "$f" ;;
            *.tar)                   tar xf "$f" ;;
            *.gz)                    gunzip -k "$f" ;;
            *.bz2)                   bunzip2 -k "$f" ;;
            *.xz)                    unxz -k "$f" ;;
            *.zst)                   unzstd "$f" ;;
            *.zip|*.jar|*.war|*.apk) unzip "$f" ;;
            *.7z)                    7z x "$f" ;;
            *.rar)                   unrar x "$f" ;;
            *.deb)                   ar x "$f" ;;
            *) printf 'extract: unknown archive type: %s\n' "$f" >&2 ;;
        esac
    done
}
alias x='extract'

# --- clipboard: copypath / copyfile / copybuffer ----------------------
# needs xclip (sudo apt install xclip)
_clip() {
    if [[ -n $WAYLAND_DISPLAY ]] && (( $+commands[wl-copy] )); then wl-copy
    elif (( $+commands[xclip] )); then xclip -selection clipboard
    elif (( $+commands[xsel] )); then xsel -ib
    else printf 'no clipboard tool: sudo apt install xclip\n' >&2; return 1
    fi
}
# copypath            -> copy current dir path
# copypath file.txt   -> copy absolute path of file.txt
copypath() {
    local p=${${1:-$PWD}:a}
    print -rn -- "$p" | _clip && printf 'copied: %s\n' "$p"
}
# copyfile notes.txt  -> copy file contents
copyfile() {
    if [[ ! -f "${1:-}" ]]; then
        printf 'Usage: copyfile <file>\n' >&2
        return 1
    fi
    _clip < "$1" && printf 'copied contents of %s\n' "$1"
}
# Ctrl+O -> copy the command currently typed on the line
copybuffer() { print -rn -- "$BUFFER" | _clip; }
zle -N copybuffer
bindkey '^O' copybuffer

